#!/bin/sh
# Present the board to a PC on the blue OTG port: a USB network link (NCM) and a serial console.
# The board answers on 10.55.0.1 and gives the PC an address by DHCP.
set -e
G=/sys/kernel/config/usb_gadget/opi
modprobe libcomposite
mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
[ -e "$G/UDC" ] && [ -n "$(cat "$G/UDC")" ] && exit 0
mkdir -p "$G"
cd "$G"
echo 0x1d6b > idVendor  # Linux Foundation
echo 0x0104 > idProduct # Multifunction Composite Gadget
echo 0x0100 > bcdDevice
echo 0x0200 > bcdUSB
mkdir -p strings/0x409
cut -c1-16 /etc/machine-id > strings/0x409/serialnumber
echo "Orange Pi" > strings/0x409/manufacturer
echo "Orange Pi 4 Pro" > strings/0x409/product
mkdir -p configs/c.1/strings/0x409
echo "network and serial console" > configs/c.1/strings/0x409/configuration
echo 250 > configs/c.1/MaxPower
mkdir -p functions/ncm.usb0 functions/acm.usb0
# Fixed, locally administered addresses, so the PC sees the same adapter every boot.
id=$(md5sum /etc/machine-id | cut -c1-10 | sed 's/../&:/g; s/:$//')
echo "02:${id}" > functions/ncm.usb0/dev_addr
echo "06:${id}" > functions/ncm.usb0/host_addr
[ -e configs/c.1/ncm.usb0 ] || ln -s functions/ncm.usb0 configs/c.1/
[ -e configs/c.1/acm.usb0 ] || ln -s functions/acm.usb0 configs/c.1/
ls /sys/class/udc | head -1 > UDC
