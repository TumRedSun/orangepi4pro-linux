-		       sunxi_irq_status_reg_from_bank(pctl->desc, i));
+		       sunxi_irq_status_reg_from_bank(pctl, i));
 
 		irq_set_chained_handler_and_data(pctl->irq[i],
 						 sunxi_pinctrl_irq_handler,
diff --git a/drivers/pinctrl/sunxi/pinctrl-sunxi.h b/drivers/pinctrl/sunxi/pinctrl-sunxi.h
index 8bd00c6ff..90880e71b 100644
--- a/drivers/pinctrl/sunxi/pinctrl-sunxi.h
+++ b/drivers/pinctrl/sunxi/pinctrl-sunxi.h
@@ -74,6 +74,18 @@
 
 #define IRQ_MEM_SIZE		0x20
 
+/* A733: IRQ registers live inside the respective bank area. */
+#define A733_BANK_BASE_OFFSET	0x80
+#define A733_BANK_MEM_SIZE	0x80
+#define A733_PULL_REGS_OFFSET	0x30
+#define A733_IRQ_CFG_REG	0xc0
+#define A733_IRQ_CTRL_REG	0xd0
+#define A733_IRQ_STATUS_REG	0xd4
+#define A733_IRQ_DEBOUNCE_REG	0xd8
+#define A733_IRQ_MEM_SIZE	0x80
+#define A733_POW_MOD_SEL_REG	0x40
+#define A733_POW_MOD_CTL_OFS	0x08
+
 #define IRQ_EDGE_RISING		0x00
 #define IRQ_EDGE_FALLING	0x01
 #define IRQ_LEVEL_HIGH		0x02
@@ -94,6 +106,12 @@
 #define SUNXI_PINCTRL_NEW_REG_LAYOUT	BIT(8)
 #define SUNXI_PINCTRL_PORTF_SWITCH	BIT(9)
 #define SUNXI_PINCTRL_ELEVEN_BANKS	BIT(10)
+/*
+ * A733 bank layout: the first bank (PB) starts at 0x80, every bank occupies
+ * 0x80 bytes (with each bank's IRQ block living in the upper part of its own
+ * bank space, not in a separate IRQ area).
+ */
+#define SUNXI_PINCTRL_A733_LAYOUT	BIT(11)
 
 #define PIO_POW_MOD_SEL_REG		0x340
 #define PIO_11B_POW_MOD_SEL_REG		0x380
@@ -187,9 +205,13 @@ struct sunxi_pinctrl {
 	struct pinctrl_dev		*pctl_dev;
 	unsigned long			flags;
 	u32				bank_mem_size;
+	u32				bank_base_offset;
 	u32				pull_regs_offset;
 	u32				dlevel_field_width;
 	u32				pow_mod_sel_offset;
+	u32				pow_mod_ctl_offset;
+	u32				irq_cfg_reg;
+	u32				irq_reg_stride;
 };
 
 #define SUNXI_PIN(_pin, ...)					\
@@ -243,14 +265,14 @@ static inline u32 sunxi_irq_hw_bank_num(const struct sunxi_pinctrl_desc *desc, u
 		return desc->irq_bank_map[bank];
 }
 
-static inline u32 sunxi_irq_cfg_reg(const struct sunxi_pinctrl_desc *desc,
+static inline u32 sunxi_irq_cfg_reg(const struct sunxi_pinctrl *pctl,
